# Master project (shared with the RAVBsoft developer portal)
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-key>

# Developer portal (licensing, releases, deployment management)
VITE_PORTAL_URL=https://ravsoft-portal.pages.dev/developer
VITE_MASTER_LICENSE_URL=https://<master-project>.supabase.co
VITE_MASTER_LICENSE_ANON_KEY=<publishable-key>

# Issued by the portal during provisioning and baked into the deployed build.
# The client never enters these; demo mode works without them.
VITE_TAW_INSTALLATION_ID=TAW-LK-XXXXXXXX
VITE_TAW_LICENSE_KEY=

# Optional: Google Maps / distance provider. Leave blank to use built-in distance table.
VITE_GOOGLE_MAPS_KEY=

# WhatsApp via WAHA (WhatsApp HTTP API) — selected by the user
VITE_WAHA_URL=
VITE_WAHA_API_KEY=
VITE_WAHA_SESSION=default
VITE_WAHA_WEBHOOK_SECRET=
VITE_WAHA_WEBHOOK_RELAY_URL=
