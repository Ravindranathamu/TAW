{
  "name": "taw-vehicle-carrier",
  "private": true,
  "version": "0.1.0",
  "description": "TAW — mobile-first vehicle carrier & fleet management PWA (RAVBsoft product line)",
  "author": "RAVBsoft <ravindranath@hotmail.co.uk>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name taw-carrier --branch main",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@supabase/supabase-js": "^2.119.0",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
